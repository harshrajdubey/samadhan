{
  "name": "samadhan-workspace",
  "version": "1.0.0",
  "license": "MIT",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "pnpm --filter @workspace/samadhan run dev",
    "build": "pnpm --filter @workspace/samadhan run build && node -e \"require('fs').cpSync('artifacts/samadhan/dist', 'dist', {recursive: true})\"",
    "typecheck": "pnpm -r --if-present run typecheck"
  },
  "private": true,
  "devDependencies": {
    "prettier": "^3.9.5",
    "typescript": "~5.9.3"
  }
}
